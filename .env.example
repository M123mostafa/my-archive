# -------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase or Neon PostgreSQL - Free Tier)
# -------------------------------------------------------------
DATABASE_URL="postgres://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# -------------------------------------------------------------
# 2. CLOUDFLARE R2 FILE STORAGE CONFIGURATION (10 GB Free Storage)
# -------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="learning-archive-files"

# Optional: Custom or Public domain for R2 bucket (if disabled, app proxies via /api/files)
# R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
